{# per-service HPA in unified mode; per-arch mode gets one HPA per Deployment #}
{% for target in dlis_scale_targets %}
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ target.name }}
  namespace: {{ dlis_namespace }}
  labels: {{ dlis_common_labels | to_json }}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{ target.name }}
  minReplicas: {{ target.min }}
  maxReplicas: {{ target.max }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: {{ dlis_hpa_cpu_utilization }}
  behavior:
    scaleDown:
      stabilizationWindowSeconds: 300
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: {{ target.name }}
  namespace: {{ dlis_namespace }}
  labels: {{ dlis_common_labels | to_json }}
spec:
  maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: dlis-{{ target.svc }}-service
{% if target.arch is defined %}
      dlis/arch: {{ target.arch }}
{% endif %}
{% endfor %}
