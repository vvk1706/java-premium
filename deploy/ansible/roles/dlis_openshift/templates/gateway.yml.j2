apiVersion: v1
kind: ConfigMap
metadata:
  name: dlis-gateway-config
  namespace: {{ dlis_namespace }}
  labels: {{ dlis_common_labels | to_json }}
data:
  nginx.conf: |
{{ lookup('ansible.builtin.template', 'nginx.conf.j2') | indent(4, true) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dlis-gateway
  namespace: {{ dlis_namespace }}
  labels:
    app.kubernetes.io/name: dlis-gateway
    app.kubernetes.io/component: gateway
    app.kubernetes.io/part-of: dlis
spec:
  replicas: {{ dlis_gateway.replicas }}
  revisionHistoryLimit: 5
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: dlis-gateway
  template:
    metadata:
      labels:
        app.kubernetes.io/name: dlis-gateway
        app.kubernetes.io/component: gateway
        app.kubernetes.io/part-of: dlis
      annotations:
        dlis/config-checksum: {{ (lookup('ansible.builtin.template', 'nginx.conf.j2') | hash('sha1')) | to_json }}
    spec:
      serviceAccountName: dlis
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: kubernetes.io/arch
                    operator: In
                    values: {{ dlis_node_arches | to_json }}
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels:
                    app.kubernetes.io/name: dlis-gateway
      containers:
        - name: nginx
          image: {{ dlis_gateway_image | to_json }}
          command: ["nginx", "-g", "daemon off;"]
          ports:
            - name: http
              containerPort: 8080
          resources:
            requests:
              cpu: {{ dlis_gateway.cpu_request | to_json }}
              memory: {{ dlis_gateway.memory_request | to_json }}
            limits:
              cpu: {{ dlis_gateway.cpu_limit | to_json }}
              memory: {{ dlis_gateway.memory_limit | to_json }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
          readinessProbe:
            httpGet: { path: /healthz, port: http }
            periodSeconds: 5
          livenessProbe:
            httpGet: { path: /healthz, port: http }
            periodSeconds: 20
          volumeMounts:
            - name: conf
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
      volumes:
        - name: conf
          configMap:
            name: dlis-gateway-config
