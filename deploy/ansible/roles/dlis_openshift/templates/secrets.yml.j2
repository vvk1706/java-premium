apiVersion: v1
kind: Secret
metadata:
  name: dlis-db2
  namespace: {{ dlis_namespace }}
  labels: {{ dlis_common_labels | to_json }}
type: Opaque
stringData:
  DB2_USER: {{ dlis_db2_user | to_json }}
  DB2_PASSWORD: {{ dlis_db2_password | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: dlis-service-account
  namespace: {{ dlis_namespace }}
  labels: {{ dlis_common_labels | to_json }}
type: Opaque
stringData:
  DLIS_SERVICE_USER: {{ dlis_service_user | to_json }}
  DLIS_SERVICE_PASSWORD: {{ dlis_service_password | to_json }}
---
# Liberty user registry, dropped into configDropins/overrides so it wins over server.xml.
# Replace by an <ldapRegistry> (or SAF registry on Z) for production.
apiVersion: v1
kind: Secret
metadata:
  name: dlis-registry
  namespace: {{ dlis_namespace }}
  labels: {{ dlis_common_labels | to_json }}
type: Opaque
stringData:
  registry.xml: |
    <server>
      <basicRegistry id="dlisRegistry" realm="DLIS Realm">
{% for u in dlis_users %}
        <user name="{{ u.name | e }}" password="{{ u.password | e }}"/>
{% endfor %}
        <user name="{{ dlis_service_user | e }}" password="{{ dlis_service_password | e }}"/>
{% set groups = (dlis_users | map(attribute='groups') | flatten | list) + ['DlisServices'] %}
{% for g in groups | unique %}
        <group name="{{ g }}">
{% for u in dlis_users if g in u.groups %}
          <member name="{{ u.name | e }}"/>
{% endfor %}
{% if g == 'DlisServices' %}
          <member name="{{ dlis_service_user | e }}"/>
{% endif %}
        </group>
{% endfor %}
      </basicRegistry>
    </server>
{% if dlis_db2_truststore_b64 | length > 0 %}
---
apiVersion: v1
kind: Secret
metadata:
  name: dlis-db2-truststore
  namespace: {{ dlis_namespace }}
  labels: {{ dlis_common_labels | to_json }}
type: Opaque
data:
  truststore.p12: {{ dlis_db2_truststore_b64 | to_json }}
stringData:
  TRUSTSTORE_PASSWORD: {{ dlis_db2_truststore_password | to_json }}
{% endif %}
{% if dlis_registry_username | length > 0 %}
---
apiVersion: v1
kind: Secret
metadata:
  name: dlis-pull-secret
  namespace: {{ dlis_namespace }}
  labels: {{ dlis_common_labels | to_json }}
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: {{ {'auths': {dlis_registry_pull.split('/')[0]: {'username': dlis_registry_username, 'password': dlis_registry_password, 'auth': (dlis_registry_username ~ ':' ~ dlis_registry_password) | b64encode}}} | to_json | to_json }}
{% endif %}
