<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.dlis</groupId>
  <artifactId>dlis-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Driver License Issuance System - Parent</name>
  <description>
    Mainframe Java project for the Driver License Issuance System.
    Runs on zLinux under IBM WebSphere Application Server Liberty.
    Transactional integration via CICS/DB2; business logic in Java.
  </description>

  <modules>
    <module>dlis-core</module>
    <module>dlis-cics-bridge</module>
    <module>dlis-web</module>
    <module>dlis-ear</module>
    <!-- Liberty/OpenShift microservices (strangler decomposition of the monolith) -->
    <module>dlis-service-commons</module>
    <module>dlis-candidate-service</module>
    <module>dlis-licensing-service</module>
    <module>dlis-payment-service</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- IBM JCICS / WAS Liberty BOM versions (available from IBM Maven repo) -->
    <ibm.jcics.version>2.000.0-6.1</ibm.jcics.version>
    <liberty.bom.version>23.0.0.9</liberty.bom.version>
    <jakartaee.version>8.0.0</jakartaee.version>
    <db2.jdbc.version>11.5.8.0</db2.jdbc.version>
    <slf4j.version>2.0.9</slf4j.version>
    <junit.version>5.10.0</junit.version>
    <mockito.version>5.24.0</mockito.version>
    <jacoco.version>0.8.15</jacoco.version>
    <mp.health.version>3.1</mp.health.version>
    <jersey.version>2.41</jersey.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Jakarta EE 8 (WAS Liberty 23.x) -->
      <dependency>
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-api</artifactId>
        <version>${jakartaee.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- IBM JCICS — CICS Transaction Server Java API -->
      <dependency>
        <groupId>com.ibm.cics</groupId>
        <artifactId>com.ibm.cics.server</artifactId>
        <version>${ibm.jcics.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- IBM DB2 JDBC Type 4 driver (zLinux) -->
      <dependency>
        <groupId>com.ibm.db2</groupId>
        <artifactId>jcc</artifactId>
        <version>${db2.jdbc.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- MicroProfile Health (javax namespace, Liberty mpHealth-3.1) -->
      <dependency>
        <groupId>org.eclipse.microprofile.health</groupId>
        <artifactId>microprofile-health-api</artifactId>
        <version>${mp.health.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- JAX-RS runtime for unit tests only (Liberty provides CXF at runtime) -->
      <dependency>
        <groupId>org.glassfish.jersey.core</groupId>
        <artifactId>jersey-common</artifactId>
        <version>${jersey.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.glassfish.jersey.inject</groupId>
        <artifactId>jersey-hk2</artifactId>
        <version>${jersey.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- JSON-P implementation for unit tests only (Liberty provides jsonp-1.1 at runtime) -->
      <dependency>
        <groupId>org.glassfish</groupId>
        <artifactId>jakarta.json</artifactId>
        <version>1.1.6</version>
        <scope>test</scope>
      </dependency>

      <!-- Logging -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>

      <!-- Test -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-core</artifactId>
        <version>${mockito.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-junit-jupiter</artifactId>
        <version>${mockito.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- Internal modules -->
      <dependency>
        <groupId>com.dlis</groupId>
        <artifactId>dlis-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.dlis</groupId>
        <artifactId>dlis-cics-bridge</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.dlis</groupId>
        <artifactId>dlis-service-commons</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>17</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <id>jacoco-prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>test</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
