<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>DLIS Web</display-name>

  <!-- Security constraints — protect all REST endpoints -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>DLIS REST API</web-resource-name>
      <url-pattern>/api/v1/*</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>DLIS_OFFICER</role-name>
      <role-name>DLIS_AUTHORITY</role-name>
      <role-name>DLIS_ADMIN</role-name>
    </auth-constraint>
    <user-data-constraint>
      <transport-guarantee>CONFIDENTIAL</transport-guarantee>
    </user-data-constraint>
  </security-constraint>

  <login-config>
    <auth-method>BASIC</auth-method>
    <realm-name>DLIS Realm</realm-name>
  </login-config>

  <security-role>
    <role-name>DLIS_OFFICER</role-name>
  </security-role>
  <security-role>
    <role-name>DLIS_AUTHORITY</role-name>
  </security-role>
  <security-role>
    <role-name>DLIS_ADMIN</role-name>
  </security-role>

  <!-- Session config -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
      <secure>true</secure>
    </cookie-config>
  </session-config>

</web-app>
